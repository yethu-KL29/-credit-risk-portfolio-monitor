# Copy to .env (local) or paste into Streamlit Cloud > Settings > Secrets. Never commit real values.
# Google Gemini key (get one at https://aistudio.google.com/apikey) - preferred if set
GEMINI_API_KEY=
# Alternative: OpenAI (or any OpenAI-compatible server via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional: override the model (defaults: gemini-flash-lite-latest / gpt-4o-mini)
ASK_MODEL=
